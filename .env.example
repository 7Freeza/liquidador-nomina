# Conexión PostgreSQL; crea previamente la base de datos liquidador_nomina
DATABASE_URL=postgres://liquidador:CAMBIAR_CLAVE_POSTGRES@localhost:5432/liquidador_nomina

# Secreto de sesión aleatorio (mínimo 32 caracteres; obligatorio en producción)
SESSION_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080

# Cuenta inicial de Administrador: gestión completa (empleados, usuarios, roles, reglas)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CLAVE_DE_12_CARACTERES_O_MAS

# Cuenta inicial de Liquidador: consulta de empleados, liquidación de horas y comprobantes
LIQUIDATOR_NAME=Liquidador
LIQUIDATOR_EMAIL=liquidador@empresa.com
LIQUIDATOR_PASSWORD=CAMBIAR_POR_UNA_CLAVE_DE_12_CARACTERES_O_MAS

# Google Workspace: usa una contraseña de aplicación; no la clave normal de Google
GMAIL_USER=nomina@empresa.com
GMAIL_APP_PASSWORD=CLAVE_DE_APLICACION_DE_GOOGLE
GMAIL_FROM=Liquidador de Nómina <nomina@empresa.com>
